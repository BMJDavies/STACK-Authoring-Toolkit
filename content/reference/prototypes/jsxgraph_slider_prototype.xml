<quiz>

<!-- ============================================================
     PROTOTYPE: JSXGraph interactive explorer with sliders

     Demonstrates: a slider that controls a parameter in a
     function plot, with a dynamic text label updating in
     real time. Based on the Ch3 B1/B2 pattern.

     Key structural features:
     - type="stack" with defaultgrade 0 (zero-mark explorer)
     - board.create('slider', [startPt, endPt, [min, init, max]])
     - Dynamic functiongraph via slider.Value() in callback
     - Dynamic text label updating with slider value
     - Reference curve (faded) for comparison
     - IIFE wrapping, unique board ID, role="img" + aria-label
     ============================================================ -->
<question type="stack">
  <name><text>PROTOTYPE: JSXGraph — interactive slider explorer</text></name>
  <questiontext format="html">
    <text><![CDATA[
<p>The graph below shows \(y = (x - a)^2\) in blue. Use the slider to change the value of \(a\) and observe how the graph translates horizontally. The faded grey curve shows \(y = x^2\) for reference.</p>

<div id="proto-slider-board" style="width:360px; height:280px;" role="img" aria-label="Interactive graph of y = (x - a) squared with slider to control a"></div>
<script>
(function() {
  var b = JXG.JSXGraph.initBoard('proto-slider-board', {
    boundingbox: [-7, 12, 7, -2],
    axis: true,
    grid: false,
    showNavigation: false,
    showCopyright: false
  });

  /* Slider: placed in top-left area of the board.
     Arguments: [start point], [end point], [min, initial, max]
     snapWidth makes it jump in integer steps. */
  var aSlider = b.create('slider', [[-6, 10], [-1, 10], [-5, 0, 5]], {
    name: 'a',
    snapWidth: 1,
    precision: 0
  });

  /* Reference curve y = x² (faded grey) */
  b.create('functiongraph', [function(x) { return x * x; }, -7, 7], {
    strokeColor: '#999999',
    strokeWidth: 1.5,
    dash: 2
  });

  /* Dynamic curve y = (x - a)² */
  b.create('functiongraph', [function(x) {
    var a = aSlider.Value();
    return (x - a) * (x - a);
  }, -7, 7], {
    strokeColor: '#003399',
    strokeWidth: 2
  });

  /* Dynamic vertex point */
  b.create('point', [
    function() { return aSlider.Value(); },
    function() { return 0; }
  ], {
    size: 4,
    color: '#003399',
    fixed: true,
    name: '',
    label: { offset: [8, -12], fontSize: 12 }
  });

  /* Dynamic text label showing the current equation */
  b.create('text', [3, 10, function() {
    var a = aSlider.Value();
    if (a === 0) return 'y = x²';
    var sign = a > 0 ? ' - ' : ' + ';
    var absA = Math.abs(a);
    return 'y = (x' + sign + absA + ')²';
  }], {
    fontSize: 14,
    color: '#003399'
  });
})();
</script>
<div style="display:none;">[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div>
