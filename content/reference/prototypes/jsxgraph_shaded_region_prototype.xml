<quiz>

<!-- ============================================================
     PROTOTYPE: JSXGraph shaded region

     Demonstrates: shading an area between a curve and the x-axis
     over a specified interval. This pattern is needed for
     Chapters 8-11 (rates of change, integration, area under
     a graph).

     Key structural features:
     - type="stack" with defaultgrade 0 (zero-mark figure)
     - JSXGraph inside [[jsxgraph]] block (NOT in a description)
     - IIFE wrapping to avoid variable collisions
     - Unique board ID pattern: <section>-<question>-board
     - Shading via board.create('curve') with filled region
     - role="img" and aria-label for accessibility
     - Bounding box with padding around the data
     ============================================================ -->
<question type="stack">
  <name><text>PROTOTYPE: JSXGraph — shaded region under a curve</text></name>
  <questiontext format="html">
    <text><![CDATA[
<p>The graph below shows \(y = {@expr@}\) with the area between the curve and the \(x\)-axis from \(x = {@a@}\) to \(x = {@b@}\) shaded.</p>

<div id="proto-shaded-board" style="width:360px; height:240px;" role="img" aria-label="Graph of {@expr@} with shaded region between x={@a@} and x={@b@}"></div>
<script>
(function() {
  var b = JXG.JSXGraph.initBoard('proto-shaded-board', {
    boundingbox: [-1, 12, 5, -2],
    axis: true,
    grid: false,
    showNavigation: false,
    showCopyright: false
  });

  /* The curve y = f(x) */
  var f = function(x) { return -x*x + 4*x + 1; };

  /* Plot the full curve */
  b.create('functiongraph', [f, -0.5, 4.5], {
    strokeColor: '#003399',
    strokeWidth: 2
  });

  /* Shaded region: build an array of points tracing the curve
     from x=a to x=b, then back along the x-axis */
  var a = {#a#}, bVal = {#b#};
  var pts = [];
  var steps = 80;
  var dx = (bVal - a) / steps;
  for (var i = 0; i <= steps; i++) {
    var xi = a + i * dx;
    pts.push([xi, f(xi)]);
  }
  /* Close the region along the x-axis */
  pts.push([bVal, 0]);
  pts.push([a, 0]);

  b.create('polygon', pts, {
    fillColor: '#003399',
    fillOpacity: 0.2,
    borders: { strokeWidth: 0 },
    vertices: { visible: false }
  });

  /* Label the bounds */
  b.create('point', [a, 0], {
    fixed: true, size: 3, color: '#003399',
    name: 'x = ' + a, label: { offset: [0, -18], fontSize: 12 }
  });
  b.create('point', [bVal, 0], {
    fixed: true, size: 3, color: '#003399',
    name: 'x = ' + bVal, label: { offset: [0, -18], fontSize: 12 }
  });
})();
</script>
<div style="display:none;">[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div>
