    <text><![CDATA[
/* Randomise: b even, qval > 0 so graph doesn't cross x-axis */
b: 2*rand_with_step(1, 5, 1) * (2*rand(2)-1);
half_b: b/2;
bsq: half_b^2;
qval: rand_with_step(1, 6, 1);
c: qval + bsq;

quad_expr: x^2 + b*x + c;
csq_inner: (x + half_b)^2;
csq_expr: (x + half_b)^2 + qval;
expand_step: (x + half_b)^2 - bsq + c;

/* Counterexample for part (e): reduce c so completed square gives qval_counter <= 0 */
c_counter: bsq - rand_with_step(1, 3, 1);
qval_counter: c_counter - bsq;

/* Answers */
ta1: 1;
ta2: 2;

/* Part (b): dropdown */
ta_opts3: [["A square is always greater than or equal to zero", true], ["A square is always positive", false], ["A square is always an integer", false]];

ta4: qval;
ta5: -half_b;

/* Part (e): answer is always No (qval_counter is always negative) */
ta_opts6: [["No", true], ["Yes", false]];
    ]]></text>
  </questionvariables>
