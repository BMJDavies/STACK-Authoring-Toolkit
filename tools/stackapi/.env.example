# Copy to tools/stackapi/.env (machine-local, not in git) and edit.
#
# STACK_VERSION: the STACK version in your Moodle, $plugin->version in
# question/type/stack/version.php. Both images and config.php use it.
STACK_VERSION=2026080600
#
# STACKAPI_IMAGE: leave unset to use the published stackmaths/stackapi image.
# Set it to stackapi-local if you built the image yourself because Docker Hub
# has none for your version (docs/SETUP.md, "Build the API image").
# STACKAPI_IMAGE=stackapi-local
#
# GOEMAXIMA_BUILD, STACKAPI_BUILD: the exact build of each image for that
# version, the part of the Docker Hub tag after the version. Leave unset for
# latest. Pin one when latest is broken: stackmaths/stackapi:2026062900-latest
# was, so 2026062900 needs STACKAPI_BUILD=1 and GOEMAXIMA_BUILD=1.2.0.
# A locally built image (STACKAPI_IMAGE=stackapi-local) is tagged latest.
# GOEMAXIMA_BUILD=1.2.0
# STACKAPI_BUILD=1
