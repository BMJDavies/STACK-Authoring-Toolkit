# Copy to tools/stackapi/.env (machine-local, not in git) and edit.
#
# STACK_VERSION: the STACK version in your Moodle, $plugin->version in
# question/type/stack/version.php. Both images and config.php use it.
STACK_VERSION=2026080600
#
# STACKAPI_IMAGE: leave unset to use the published stackmaths/stackapi image.
# Set it to stackapi-local if you built the image yourself because Docker Hub
# has none for your version (SETUP.md, "Build the API image").
# STACKAPI_IMAGE=stackapi-local
