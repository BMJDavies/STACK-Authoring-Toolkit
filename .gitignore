# Your project lives in its own git repository inside the kit, in project/
# (see README.md). The kit never tracks it. If you keep more projects side by
# side and select them with STACK_PROJECT, add their folders here too.
/project/

# Your personal extensions live in extensions/, created from templates/extensions/
# and possibly its own git repository (see README.md). The kit never tracks it,
# and the extensions apply across projects.
/extensions/

# Runtime noise
*.log

# macOS
.DS_Store

# Editor
.vscode/
*.swp

# Claude Code local settings (keep .claude/agents, commands and skills tracked)
.claude/settings.local.json

# Machine-local STACK API settings (see tools/stackapi/.env.example)
tools/stackapi/.env
