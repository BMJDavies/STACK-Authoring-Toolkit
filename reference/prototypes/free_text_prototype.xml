<!-- ============================================================
     PROTOTYPE A2: free-text working, several values extracted.
     The stem asks for labelled final lines (x = ..., y = ...). One
     laststringremainderwhitespace extractor per value sends each to its
     own hidden input, graded by its own PRT.
     ============================================================ -->
<question type="stack">
  <name><text>PROTOTYPE: Free text A2 — working with two extracted values</text></name>
  <questiontext format="html">
    <text><![CDATA[
<p>Solve the simultaneous equations \[ {@eq1@}, \qquad {@eq2@}. \]</p>
<p>Type your working line by line. Put mathematics between backticks. Finish with two lines on their own, <code>x = </code> your value and <code>y = </code> your value.</p>
<div class="free-text-container">
[[input:ans1]] [[validation:ans1]]
[[ascii input="ans1"]]
  [[extractor type="laststringremainderwhitespace" targetinput="ans2" search="x =" /]]
  [[extractor type="laststringremainderwhitespace" targetinput="ans3" search="y =" /]]
[[/ascii]]
</div>
<div>[[hint title="How to type your working"]][[commonstring key="free_text_fact"/]][[/hint]]</div>
<div style="display:none">[[input:ans2]] [[input:ans3]]</div>
<div>Your value of \(x\): [[validation:ans2]]</div>
<div>[[feedback:prt2]]</div>
<div>Your value of \(y\): [[validation:ans3]]</div>
<div>[[feedback:prt3]]</div>
    ]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[
<p>Eliminate \(y\): multiply the first equation by \({@b2@}\) and the second by \({@b1@}\), and subtract one from the other. Then substitute \(x\) back into the first equation.</p>
[[ascii]]{@ta1@}[[/ascii]]
    ]]></text>
  </generalfeedback>
  <defaultgrade>2</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion>
    <text>2026080600</text>
  </stackversion>
  <questionvariables>
    <text><![CDATA[
ordergreat(x, y);
/* Integer solution (x0, y0), with x0 # y0 so that a swap is detectable. */
x0: rand_with_prohib(-5, 5, [0]);
y0: rand_with_prohib(-5, 5, [0, x0]);
/* All coefficients positive, so no line of the model working starts with a
   negative product, which prints as -(6*x). b1, b2 >= 2, so it never multiplies
   by 1. b2 # a2*b1/a1 keeps the determinant a1*b2 - a2*b1 away from 0. */
a1: rand_with_step(1, 4, 1);
a2: rand_with_step(1, 4, 1);
b1: rand_with_step(2, 4, 1);
b2: rand_with_prohib(2, 5, [a2*b1/a1]);
/* Subtract whichever way leaves a positive coefficient of x. */
sg: signum(a1*b2 - a2*b1);
dx: sg*(a1*b2 - a2*b1);
c1: a1*x0 + b1*y0;
c2: a2*x0 + b2*y0;
eq1: a1*x + b1*y = c1;
eq2: a2*x + b2*y = c2;

/* Wrong values for the generic-feedback tests: offsets that never equal the swapped value. */
other_x: if is(x0+1 = y0) then x0-1 else x0+1;
other_y: if is(y0+1 = x0) then y0-1 else y0+1;

ta1: castext("Multiply the first equation by {#b2#} and the second by {#b1#}, then subtract one from the other.
`
{#expand(b2*eq1)#}
{#expand(b1*eq2)#}
{#dx*x#} = {#sg*(b2*c1-b1*c2)#}
`
Substitute into the first equation.
`
{#a1*x0+b1*y#} = {#c1#}
`
So
`
x = {#x0#}
y = {#y0#}
`
");
ta2: x0;
ta3: y0;
    ]]></text>
  </questionvariables>
  <specificfeedback format="html">
    <text></text>
  </specificfeedback>
  <questionnote format="html">
    <text>\({@eq1@}\), \({@eq2@}\); \(x = {@x0@}\), \(y = {@y0@}\).</text>
  </questionnote>
