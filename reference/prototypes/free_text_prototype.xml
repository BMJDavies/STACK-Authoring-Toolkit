<!-- ============================================================
     PROTOTYPE A: free-text working, final answer extracted and graded.
     The student types their working; the last line of mathematics is
     copied by an [[extractor]] into a hidden algebraic input, which the
     PRT grades. The working itself is not graded.
     ============================================================ -->
<question type="stack">
  <name><text>PROTOTYPE: Free text A — working with extracted final answer</text></name>
  <questiontext format="html">
    <text><![CDATA[
<p>Solve \({@eql@} = {@eqr@}\).</p>
<p>Type your working line by line. Put mathematics between backticks. Your last line of mathematics must be your answer, in the form \(x = \dots\).</p>
<div class="free-text-container">
[[input:ans1]] [[validation:ans1]]
[[ascii input="ans1"]]
  [[extractor type="lastexpr" targetinput="ans2" /]]
[[/ascii]]
</div>
<div>[[hint title="How to type your working"]][[commonstring key="free_text_fact"/]][[/hint]]</div>
<div style="display:none">[[input:ans2]]</div>
<div>Your final answer: [[validation:ans2]]</div>
    ]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[
<p>Expand the bracket, collect the terms in \(x\) on the side where their coefficient is positive, then divide.</p>
[[ascii]]{@ta1@}[[/ascii]]
    ]]></text>
  </generalfeedback>
  <defaultgrade>1</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion>
    <text>2026080600</text>
  </stackversion>
  <questionvariables>
    <text><![CDATA[
/* p(x+q) = r x + s has the integer solution x = v. r > p, so p - r is never 0. */
p: rand_with_step(2, 5, 1);
q: rand_with_prohib(-5, 5, [0]);
v: rand_with_prohib(-6, 6, [0]);
r: p + rand([1, 2, 3]);
s: p*(v+q) - r*v;
eql: p*(x+q);
eqr: r*x + s;

/* Misconception: p(x+q) expanded as px + q. Differs from v on every seed, since q(1-p) is never 0. */
wrong_v: (q-s)/(r-p);
/* A wrong value for the generic-feedback test: an offset from v that never equals wrong_v. */
other_v: if is(v+1 = wrong_v) then v-1 else v+1;

/* Model working, typed as a student would. It is a string, as the free-text input requires. */
ta1: castext("Expand the bracket and collect the terms in `x` on the right.
`
{#eql#} = {#eqr#}
{#expand(eql)#} = {#eqr#}
{#p*q-s#} = {#(r-p)*x#}
x = {#v#}
`
");
ta2: x = v;
    ]]></text>
  </questionvariables>
  <specificfeedback format="html">
    <text>[[feedback:prt2]]</text>
  </specificfeedback>
  <questionnote format="html">
    <text>\({@eql@} = {@eqr@}\), \(x = {@v@}\), misconception \(x = {@wrong_v@}\).</text>
  </questionnote>
  <questiondescription format="html"><text><![CDATA[This question is original to this kit and does not come from a source text. It is the reference example of free-text working with an extracted final answer.]]></text></questiondescription>
